# ==============================================================================
# Old Bear Battles - Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Network & Service Ports (Bug #46)
# ------------------------------------------------------------------------------
# Service ports (Optional: yarn dev automatically searches from port 3000 for free ports.
# Uncomment only if you wish to enforce specific fixed ports across runs.)
# CLIENT_PORT=3000
# SERVER_PORT=3001

# Nginx reverse proxy HTTP ingress port
NGINX_PORT=80

# PostgreSQL database host port
POSTGRES_PORT=5432

# ------------------------------------------------------------------------------
# 2. Database Configuration
# ------------------------------------------------------------------------------
POSTGRES_USER=oldbear
POSTGRES_PASSWORD=oldbear_secret_password
POSTGRES_DB=oldbear_vtt
DATABASE_URL=postgres://oldbear:oldbear_secret_password@postgres:5432/oldbear_vtt

# ------------------------------------------------------------------------------
# 3. Environment & Runtime
# ------------------------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info

# ------------------------------------------------------------------------------
# 4. Upload & Storage Limits
# ------------------------------------------------------------------------------
# Maximum file upload size in Megabytes (for maps, tokens, and audio assets)
MAX_UPLOAD_SIZE_MB=50

# ------------------------------------------------------------------------------
# 5. Security & CORS
# ------------------------------------------------------------------------------
# Allowed origins for HTTP API requests ('*' for permissive local dev)
CORS_ORIGIN=*
# Secret key used for session authentication / tokens
SESSION_SECRET=oldbear_session_development_secret_change_in_production

# ------------------------------------------------------------------------------
# 6. WebRTC Voice & P2P Networking (STUN / TURN)
# ------------------------------------------------------------------------------
# STUN server (NAT traversal discovery). Public Google STUN server by default.
STUN_SERVER_URL=stun:stun.l.google.com:19302

# TURN relay server (Optional, recommended for production when players are behind
# symmetric NATs, mobile carrier networks, or restrictive firewalls).
# Example with coturn: turn:turn.yourdomain.com:3478
TURN_SERVER_URL=
TURN_USERNAME=
TURN_CREDENTIAL=

# ------------------------------------------------------------------------------
# 7. Container Registry & Remote Deployment
# ------------------------------------------------------------------------------
# Registry prefix for building, pushing, and pulling images (default: ghcr.io/headhunter45/)
# Leave empty to use default ghcr.io registry or specify custom registry.
IMAGE_REGISTRY=ghcr.io/headhunter45/
IMAGE_TAG=latest

# Persistent host storage path for PostgreSQL (e.g. /mnt/Data/Apps/oldbear-vtt/pgdata)
# Leave empty to use the default named Docker volume ('pgdata').
PGDATA_PATH=

# ------------------------------------------------------------------------------
# 8. UI & Client Settings (Bug #69)
# ------------------------------------------------------------------------------
# Duration in milliseconds for toast notifications and announcement banners (default: 4500)
TOAST_DURATION_MS=4500
VITE_TOAST_DURATION_MS=4500

# ------------------------------------------------------------------------------
# 9. Feature Flags (OB-232)
# ------------------------------------------------------------------------------
# Enable or disable individual platform capabilities.
# In production, these rely on container / host environment variables and can be
# toggled after deployment without rebuilding the frontend bundle.
# In development, these are read directly from .env and hot-reloaded.
# Values accept: true/false, 1/0, yes/no, on/off, enabled/disabled.

# FEATURE_BRAWL_MODE=false        # Tabletop wargaming Brawl mode platform (default: false)
# FEATURE_CHESS_CLOCK=false       # Match chess clocks in Brawl wargaming mode (default: false)
# FEATURE_VOICE_CHAT=true         # WebRTC voice chat and audio settings (default: true)
# FEATURE_SOUNDBOARD=true         # Audio soundboard and ambient tracks (default: true)
# FEATURE_DICE_ROLLER=true        # 3D dice roller and chat rolls (default: true)
# FEATURE_SCOREBOARD=true         # Match victory point scoreboard in Brawl (default: true)
# FEATURE_OBJECTIVES=true         # Objective markers and control zone scoring (default: true)
# FEATURE_TO_MODE=true            # Tournament Organizer rulings & privacy controls (default: true)
# FEATURE_DNDBEYOND=true          # D&D Beyond character importer and syncing (default: true)
# FEATURE_PATHBUILDER=true        # Pathbuilder 2e character JSON importer (default: true)
# FEATURE_ARMY_ROSTER=true        # Wargaming army roster & NewRecruit/BattleScribe ingestion (default: true)
# FEATURE_FOG_OF_WAR=true         # Dynamic fog of war canvas rendering and controls (default: true)

